{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Release Preparation Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "status",
    "candidate",
    "version",
    "artifact",
    "changes",
    "recovery",
    "promotion",
    "reproducibility",
    "evidence",
    "boundaries"
  ],
  "properties": {
    "schema": {
      "const": "com.turpial.release-preparation-plan/v1"
    },
    "status": {
      "const": "RELEASE_PREPARATION_PASS"
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity",
        "security_approval_evidence",
        "immutable"
      ],
      "properties": {
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "security_approval_evidence": {
          "type": "string",
          "minLength": 1
        },
        "immutable": {
          "const": true
        }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "basis"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "candidate_binding",
        "identity_rule"
      ],
      "properties": {
        "strategy": {
          "enum": [
            "PROMOTE_EXISTING",
            "BUILD_ONCE_FROM_CANDIDATE",
            "PLATFORM_REBUILD_FROM_PINNED_CANDIDATE",
            "NO_BINARY_ARTIFACT"
          ]
        },
        "candidate_binding": {
          "const": "PLAN_CANDIDATE"
        },
        "identity_rule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "changes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "basis",
        "items",
        "compatibility_notes",
        "migration_notes"
      ],
      "properties": {
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "compatibility_notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "migration_notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger_conditions",
        "target",
        "procedure",
        "data_compatibility",
        "verification"
      ],
      "properties": {
        "trigger_conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "procedure": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "data_compatibility": {
          "type": "string",
          "minLength": 1
        },
        "verification": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mechanism",
        "target",
        "authorization_boundary",
        "post_promotion_smoke"
      ],
      "properties": {
        "mechanism": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "authorization_boundary": {
          "type": "string",
          "minLength": 1
        },
        "post_promotion_smoke": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "same_candidate_same_plan",
        "required_inputs"
      ],
      "properties": {
        "same_candidate_same_plan": {
          "const": true
        },
        "required_inputs": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_identity_verified",
        "security_approval_verified",
        "version_basis_verified",
        "change_set_verified",
        "artifact_rule_verified",
        "recovery_verified",
        "promotion_mechanism_verified"
      ],
      "properties": {
        "candidate_identity_verified": {
          "const": true
        },
        "security_approval_verified": {
          "const": true
        },
        "version_basis_verified": {
          "const": true
        },
        "change_set_verified": {
          "const": true
        },
        "artifact_rule_verified": {
          "const": true
        },
        "recovery_verified": {
          "const": true
        },
        "promotion_mechanism_verified": {
          "const": true
        }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_mutation_performed",
        "tag_created",
        "published",
        "deployed"
      ],
      "properties": {
        "candidate_mutation_performed": {
          "const": false
        },
        "tag_created": {
          "const": false
        },
        "published": {
          "const": false
        },
        "deployed": {
          "const": false
        }
      }
    }
  }
}
